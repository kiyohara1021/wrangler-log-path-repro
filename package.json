{
  "name": "wrangler-log-path-repro",
  "private": true,
  "type": "module",
  "scripts": {
    "build:static": "vite build --config vite.static.config.ts",
    "build:dynamic": "vite build --config vite.dynamic.config.ts",
    "build:env": "WRANGLER_LOG_PATH=.wrangler-logs/env vite build --config vite.static.config.ts",
    "build:writelogs": "vite build --config vite.writelogs.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "vite": "8.3.6",
    "wrangler": "4.162.0"
  }
}
